#!/usr/bin/env bash
set -euo pipefail

repo_dir=/srv/apps/jackhales-testing/repo
state_file=/srv/apps/jackhales-testing/.last-deployed-sha

cd "$repo_dir"

git fetch origin main
remote_sha="$(git rev-parse origin/main)"
current_sha="$(git rev-parse HEAD 2>/dev/null || true)"
deployed_sha="$(cat "$state_file" 2>/dev/null || true)"
running_services="$(IMAGE_TAG=local docker compose ps --status running --services 2>/dev/null | sort | tr '\n' ' ')"

if [[ "$current_sha" == "$remote_sha" && "$deployed_sha" == "$remote_sha" && "$running_services" == *"jackhales-backend"* && "$running_services" == *"frontend"* ]]; then
  echo "No deploy needed for $remote_sha"
  exit 0
fi

# GitHub Actions builds both images and tags them with the commit sha. Wait
# until both exist before touching anything: the timer checks again in a
# minute, and the running site stays as it is until then. If CI fails for a
# commit, its images never appear and the site keeps the last good deploy.
frontend_image="ghcr.io/halesyy/jackhales-com-frontend:$remote_sha"
backend_image="ghcr.io/halesyy/jackhales-com-backend:$remote_sha"
for image in "$backend_image" "$frontend_image"; do
  if ! docker manifest inspect "$image" >/dev/null 2>&1; then
    echo "Waiting for CI to publish $image"
    exit 0
  fi
done

git checkout -q main
git reset --hard "$remote_sha"
ln -sfn ../.env .env

# Nothing is built on this host any more. Next.js builds froze compute-2-sydney
# (13 Jul, 12 Nov) even when capped, so the host only pulls finished images.
docker pull -q "$backend_image"
docker pull -q "$frontend_image"
# Keep the "local" tag the running containers and the check above use.
docker tag "$backend_image" ghcr.io/halesyy/jackhales-com-backend:local
docker tag "$frontend_image" ghcr.io/halesyy/jackhales-com-frontend:local

IMAGE_TAG=local docker compose up -d --no-build --remove-orphans
IMAGE_TAG=local docker compose ps

backend_id="$(IMAGE_TAG=local docker compose ps -q jackhales-backend)"
backend_health=""
for _ in $(seq 1 60); do
  backend_health="$(docker inspect --format '{{.State.Health.Status}}' "$backend_id" 2>/dev/null || true)"
  if [[ "$backend_health" == "healthy" ]]; then
    break
  fi
  sleep 2
done

if [[ "$backend_health" != "healthy" ]]; then
  echo "Backend did not become healthy; refusing to finalize deployment." >&2
  IMAGE_TAG=local docker compose ps >&2
  exit 1
fi

printf '%s\n' "$remote_sha" > "$state_file"
# Drop the previous commit's sha-tagged images so old layers do not pile up.
docker image ls --format '{{.Repository}}:{{.Tag}}' \
  | grep -E '^ghcr\.io/halesyy/jackhales-com-(frontend|backend):[0-9a-f]{40}$' \
  | grep -v ":$remote_sha\$" \
  | xargs -r docker image rm >/dev/null 2>&1 || true
